import { useEffect, useState } from "react";
import { request } from "./api";

const types = [
  { code: "SP", name: "Prioritária" },
  { code: "SG", name: "Geral" },
  { code: "SE", name: "Retirada de Exames" }
];

function Header({ page, setPage, user, logout }) {
  return (
    <header className="topbar">
      <div>
        <strong>nassauTickets</strong>
        <span>Sistema de Atendimento</span>
      </div>
      <nav>
        {["totem", "atendente", "painel"].map((item) => (
          <button key={item} className={page === item ? "active" : ""} onClick={() => setPage(item)}>
            {item[0].toUpperCase() + item.slice(1)}
          </button>
        ))}
        {user?.role === "GESTOR" && (
          <button className={page === "relatorios" ? "active" : ""} onClick={() => setPage("relatorios")}>
            Relatórios
          </button>
        )}
        <button className={page === "documentacao" ? "active" : ""} onClick={() => setPage("documentacao")}>
          Como funciona
        </button>
        {user ? <button onClick={logout}>Sair</button> : <button onClick={() => setPage("login")}>Login</button>}
      </nav>
    </header>
  );
}

function Totem() {
  const [ticket, setTicket] = useState(null);
  const [error, setError] = useState("");

  async function emit(type) {
    setError("");
    try { setTicket(await request("/tickets", { method: "POST", body: JSON.stringify({ type }) })); }
    catch (e) { setError(e.message); }
  }

  return (
    <section className="card">
      <h1>Emissão de senha</h1>
      <p>Selecione o tipo de atendimento:</p>
      <div className="button-grid">
        {types.map(t => <button key={t.code} onClick={() => emit(t.code)}>
          <b>{t.code}</b><span>{t.name}</span>
        </button>)}
      </div>
      {ticket && <div className="ticket"><small>Sua senha é</small><strong>{ticket.number}</strong><span>Aguarde a chamada no painel.</span></div>}
      {error && <p className="error">{error}</p>}
    </section>
  );
}

function Login({ onLogin }) {
  const [form, setForm] = useState({ username: "admin", password: "admin123" });
  const [error, setError] = useState("");

  async function submit(e) {
    e.preventDefault();
    try { const data = await request("/auth/login", { method: "POST", body: JSON.stringify(form) }); onLogin(data); }
    catch (e) { setError(e.message); }
  }

  return <section className="card narrow">
    <h1>Login do atendente</h1>
    <form onSubmit={submit}>
      <label>Usuário<input value={form.username} onChange={e => setForm({...form, username:e.target.value})}/></label>
      <label>Senha<input type="password" value={form.password} onChange={e => setForm({...form, password:e.target.value})}/></label>
      <button className="primary">Entrar</button>
    </form>
    {error && <p className="error">{error}</p>}
  </section>;
}

function Atendente({ user }) {
  const [counter, setCounter] = useState("1");
  const [current, setCurrent] = useState(null);
  const [message, setMessage] = useState("");

  async function next() {
    try { const data = await request("/tickets/next", {method:"POST", body:JSON.stringify({counter:Number(counter)})}); setCurrent(data); setMessage(`Senha ${data.number} chamada.`); }
    catch(e) { setMessage(e.message); }
  }
  async function action(path) {
    try { await request(path, {method:"POST", body:JSON.stringify({counter:Number(counter)})}); setMessage("Operação realizada."); }
    catch(e) { setMessage(e.message); }
  }

  return <section className="card">
    <h1>Atendimento</h1>
    <p>Olá, {user.name}. Selecione o guichê.</p>
    <label>Guichê<input type="number" min="1" value={counter} onChange={e=>setCounter(e.target.value)}/></label>
    <div className="actions">
      <button className="primary" onClick={next}>Chamar próxima senha</button>
      {current && <>
        <div className="current"><small>Senha chamada</small><strong>{current.number}</strong><span>{current.type} • Guichê {counter}</span></div>
        <button onClick={()=>action(`/tickets/${current.id}/start`)}>Iniciar atendimento</button>
        <button onClick={()=>action(`/tickets/${current.id}/recall`)}>Chamar novamente</button>
        <button onClick={()=>action(`/tickets/${current.id}/finish`)}>Finalizar atendimento</button>
        {current.call_count >= 2 && <button onClick={()=>action(`/tickets/${current.id}/no-show`)}>Não compareceu</button>}
      </>}
    </div>
    {message && <p className="info">{message}</p>}
  </section>;
}

function Painel() {
  const [rows, setRows] = useState([]);
  useEffect(() => {
    const load = () => request("/panel").then(setRows).catch(()=>{});
    load(); const id = setInterval(load, 3000); return ()=>clearInterval(id);
  }, []);
  return <section className="card">
    <h1>Painel de chamadas</h1>
    <p>Últimas 5 senhas chamadas</p>
    <div className="panel">{rows.map((r,i)=><div className="panel-row" key={i}><strong>{r.number}</strong><span>Guichê {r.counter_number ?? "-"}</span></div>)}</div>
  </section>;
}

function Relatorios() {
  const [data, setData] = useState(null);
  useEffect(()=>{ request("/reports").then(setData).catch(()=>{}); },[]);
  if (!data) return <section className="card"><h1>Relatórios</h1><p>Carregando...</p></section>;
  const s=data.summary;
  return <section className="card">
    <h1>Relatório diário</h1>
    <div className="stats">
      <div><b>{s.issued || 0}</b><span>Emitidas</span></div>
      <div><b>{s.attended || 0}</b><span>Atendidas</span></div>
      <div><b>{s.average_minutes || 0} min</b><span>Tempo médio</span></div>
    </div>
    <h2>Por prioridade</h2>
    <table><thead><tr><th>Tipo</th><th>Emitidas</th><th>Atendidas</th></tr></thead>
      <tbody>
        <tr><td>SP</td><td>{s.sp_issued||0}</td><td>{s.sp_attended||0}</td></tr>
        <tr><td>SE</td><td>{s.se_issued||0}</td><td>{s.se_attended||0}</td></tr>
        <tr><td>SG</td><td>{s.sg_issued||0}</td><td>{s.sg_attended||0}</td></tr>
      </tbody>
    </table>
    <h2>Detalhamento</h2>
    <div className="table-wrap"><table><thead><tr><th>Senha</th><th>Tipo</th><th>Emissão</th><th>Guichê</th><th>Status</th></tr></thead>
      <tbody>{data.details.map(r=><tr key={r.number}><td>{r.number}</td><td>{r.type}</td><td>{new Date(r.issued_at).toLocaleString("pt-BR")}</td><td>{r.counter_number??"-"}</td><td>{r.status}</td></tr>)}</tbody>
    </table></div>
  </section>;
}

function Documentacao() {
  return (
    <section className="card documentation">
      <div className="doc-intro">
        <span className="eyebrow">GUIA DO PROJETO</span>
        <h1>Como o nassauTickets foi feito</h1>
        <p>
          Esta parte do sistema foi feita para deixar o projeto mais fácil de entender.
          Em vez de só mostrar os arquivos, a ideia é explicar o motivo de cada parte
          e o que acontece quando alguém usa o sistema.
        </p>
      </div>

      <div className="doc-section">
        <h2>1. A ideia geral</h2>
        <p>
          O projeto é dividido em três partes. O React cuida do que aparece na tela,
          o Node.js com Express recebe as solicitações e aplica as regras do atendimento,
          e o MySQL guarda os dados. Assim, cada parte tem uma responsabilidade bem definida.
        </p>
        <div className="flow">
          <div><b>React</b><span>telas e interação</span></div>
          <div className="arrow">→</div>
          <div><b>Express</b><span>API e regras</span></div>
          <div className="arrow">→</div>
          <div><b>MySQL</b><span>dados do sistema</span></div>
        </div>
      </div>

      <div className="doc-section">
        <h2>2. Frontend: React</h2>
        <p>
          O arquivo <code>App.jsx</code> concentra as telas principais. Ele usa componentes
          para separar o totem, o login, o atendimento, o painel e os relatórios.
          Isso facilita a manutenção porque cada parte da interface fica responsável por uma tarefa.
        </p>
        <div className="doc-grid">
          <article><h3>useState</h3><p>Guarda informações que mudam na tela, como a senha emitida, o usuário logado e o guichê escolhido.</p></article>
          <article><h3>useEffect</h3><p>Executa ações depois que o componente aparece. O painel usa isso para buscar as chamadas periodicamente.</p></article>
          <article><h3>props</h3><p>Permitem passar informações de um componente para outro. O cabeçalho, por exemplo, recebe a página atual e o usuário.</p></article>
          <article><h3>eventos</h3><p>Cliques e envios de formulário chamam funções que conversam com a API e atualizam a interface.</p></article>
        </div>
      </div>

      <div className="doc-section">
        <h2>3. O arquivo api.js</h2>
        <p>
          Em <code>frontend/src/api.js</code> existe uma função chamada <code>request</code>.
          Ela evita repetir o mesmo código toda vez que o React precisa conversar com o backend.
          A função monta a URL, envia os dados em JSON, coloca o token de autenticação quando existe
          e transforma a resposta em um objeto que o React consegue usar.
        </p>
      </div>

      <div className="doc-section">
        <h2>4. Backend: Node.js e Express</h2>
        <p>
          O arquivo <code>backend/src/server.js</code> é o ponto central da API.
          Cada rota representa uma ação do sistema. Por exemplo, <code>POST /api/tickets</code>
          emite uma senha e <code>POST /api/tickets/next</code> chama a próxima senha.
        </p>
        <div className="doc-list">
          <div><b>/api/auth/login</b><span>confere usuário e senha e devolve um token.</span></div>
          <div><b>/api/tickets</b><span>emite uma senha e registra a emissão.</span></div>
          <div><b>/api/tickets/next</b><span>escolhe a próxima senha respeitando a prioridade.</span></div>
          <div><b>/api/panel</b><span>busca as cinco últimas chamadas para o painel.</span></div>
          <div><b>/api/reports</b><span>calcula os dados do relatório diário do gestor.</span></div>
          <div><b>/api/audit</b><span>consulta o histórico das ações realizadas.</span></div>
        </div>
      </div>

      <div className="doc-section">
        <h2>5. Regras da fila</h2>
        <p>
          A função que escolhe a próxima senha consulta a configuração da vez de prioridade e usa
          uma ordenação no MySQL. A lógica mantém o ciclo definido na atividade: primeiro uma SP quando
          disponível e, depois, SE ou SG. Depois do atendimento prioritário, a vez volta para SE/SG.
        </p>
        <p>
          As consultas usam transações e bloqueio da linha com <code>FOR UPDATE</code>. Isso é importante
          porque dois atendentes podem tentar chamar uma senha praticamente ao mesmo tempo. A transação
          faz com que a escolha e a atualização aconteçam juntas, reduzindo o risco de dois guichês
          receberem a mesma senha.
        </p>
      </div>

      <div className="doc-section">
        <h2>6. Banco de dados</h2>
        <p>
          O arquivo <code>backend/sql/schema.sql</code> cria o banco <code>nassau_tickets</code> e suas
          tabelas. A tabela <code>tickets</code> guarda as senhas e os horários de cada etapa.
          <code>attendants</code> guarda os usuários que podem entrar no sistema, enquanto
          <code>audit_logs</code> registra o que aconteceu durante o atendimento.
        </p>
      </div>

      <div className="doc-section">
        <h2>7. Login e segurança</h2>
        <p>
          A senha do atendente não fica salva diretamente no banco. Ela é comparada usando
          <code>bcryptjs</code>. Depois do login, o servidor cria um token JWT com validade de oito horas.
          As rotas protegidas verificam esse token antes de permitir ações de atendente ou gestor.
        </p>
      </div>

      <div className="doc-section">
        <h2>8. O caminho de uma senha</h2>
        <div className="states">
          <span>EMITIDA</span><b>→</b><span>AGUARDANDO</span><b>→</b><span>CHAMADA</span><b>→</b><span>EM ATENDIMENTO</span><b>→</b><span>ATENDIDA</span>
        </div>
        <p>
          Se o cliente não aparecer depois das chamadas previstas, a senha pode chegar ao estado
          <code>NAO_COMPARECEU</code>. Os horários ficam registrados para que o gestor consiga conferir
          depois o que aconteceu.
        </p>
      </div>

      <div className="doc-section">
        <h2>9. Arquivos principais</h2>
        <div className="file-table">
          <div><code>frontend/src/App.jsx</code><span>Telas, componentes, estados e eventos da interface.</span></div>
          <div><code>frontend/src/api.js</code><span>Função central para fazer as requisições à API.</span></div>
          <div><code>frontend/src/main.jsx</code><span>Inicializa o React e renderiza o App na página.</span></div>
          <div><code>frontend/src/styles.css</code><span>Visual, espaçamento, botões, tabelas e responsividade.</span></div>
          <div><code>backend/src/server.js</code><span>Rotas, regras de negócio e respostas da API.</span></div>
          <div><code>backend/src/auth.js</code><span>Middleware que protege rotas de atendente e gestor.</span></div>
          <div><code>backend/src/db.js</code><span>Cria o pool de conexões com o MySQL.</span></div>
          <div><code>backend/sql/schema.sql</code><span>Cria banco, tabelas e usuário inicial de demonstração.</span></div>
          <div><code>.env</code><span>Guarda as configurações locais do banco e da API. Não deve ir para o GitHub.</span></div>
        </div>
      </div>

      <div className="doc-note">
        <strong>Uma forma simples de entender o projeto:</strong> quando alguém pede uma senha, o React
        faz uma requisição. O Express recebe essa requisição, conversa com o MySQL e devolve o resultado.
        O React recebe a resposta e atualiza a tela. É essa conversa entre as três partes que faz o sistema funcionar.
      </div>
    </section>
  );
}

export default function App() {
  const [page, setPage] = useState("totem");
  const [user, setUser] = useState(() => JSON.parse(localStorage.getItem("user") || "null"));

  function login(data) { localStorage.setItem("token", data.token); localStorage.setItem("user", JSON.stringify(data.user)); setUser(data.user); setPage("atendente"); }
  function logout() { localStorage.clear(); setUser(null); setPage("totem"); }

  return <><Header page={page} setPage={setPage} user={user} logout={logout}/>
    <main>
      {page==="totem" && <Totem/>}
      {page==="login" && <Login onLogin={login}/>}
      {page==="atendente" && (user ? <Atendente user={user}/> : <Login onLogin={login}/>)}
      {page==="painel" && <Painel/>}
      {page==="relatorios" && (user?.role==="GESTOR" ? <Relatorios/> : <Login onLogin={login}/>)}
      {page==="documentacao" && <Documentacao/>}
    </main>
  </>;
}
